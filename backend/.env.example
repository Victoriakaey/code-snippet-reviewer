# Copy to .env and adjust. Never commit real secrets.

# LLM provider. No automatic fallback between providers.
#   ollama — real local review provider (default)
#   openai — real cloud provider via the OpenAI API (requires OPENAI_API_KEY)
#   mock   — deterministic stand-in, no model needed (placeholder findings, not a real review)
LLM_PROVIDER=ollama

# Ollama (local) — install Ollama and pull a code model, e.g. `ollama pull qwen2.5-coder:7b`.
# Set OLLAMA_MODEL to whatever local tag you have (e.g. qwen2.5-coder:7b-instruct-q4_K_M).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Request timeout in seconds; raise for slow local models or large snippets.
OLLAMA_TIMEOUT=120

# OpenAI (cloud) — set LLM_PROVIDER=openai to use it. The key is read ONLY from the
# environment / this .env (which is gitignored); it is never hardcoded.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# gpt-5-family reasoning control: minimal | low | medium | high (leave blank for the default).
# We do NOT send `temperature` for OpenAI — gpt-5 reasoning models reject/ignore it.
OPENAI_REASONING_EFFORT=
# Request timeout (seconds) and an optional output-token cap (blank = model default).
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=

# Persistence (SQLite file; not in-memory).
DATABASE_URL=sqlite:///./data/app.db
