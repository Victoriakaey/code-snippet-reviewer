# Copy to .env and adjust. Never commit real secrets.

# LLM provider: "ollama" (local, default) or "openai". No automatic fallback between them.
LLM_PROVIDER=ollama

# Ollama (local) — install Ollama and run `ollama pull qwen2.5-coder:7b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI (only used when LLM_PROVIDER=openai). Keep the key server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Persistence (SQLite file; not in-memory).
DATABASE_URL=sqlite:///./data/app.db
